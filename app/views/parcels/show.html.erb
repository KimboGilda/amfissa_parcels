<div class="container mt-4">
  <!-- Header Section -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1><%= @parcel.name %></h1>
    <%= link_to parcels_path, class: 'btn btn-outline-secondary' do %>
      <i class="fa-solid fa-arrow-left"></i> Back to All Parcels
    <% end %>
  </div>

  <!-- Parcel Information Card -->
  <div class="row mb-4">
    <div class="col-md-12">
      <div class="card shadow-sm">
        <div class="card-body">
          <h5 class="card-title mb-3">Parcel Information</h5>
          <div class="row">
            <div class="col-md-4">
              <p><strong>Name:</strong> <%= @parcel.name %></p>
            </div>
            <div class="col-md-4">
              <p><strong>KAEK:</strong> <%= @parcel.kaek %></p>
            </div>
            <div class="col-md-4">
              <p><strong>Area:</strong> <%= @parcel.area %> m²</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Map Container Card -->
  <div class="row mb-4">
    <div class="col-md-12">
      <div class="card shadow-sm">
        <div class="card-body p-0">
          <div class="map-container" style="height: 500px; width: 100%;">
            <div style="width: 100%; height: 100%;"
              data-controller="map"
              data-map-api-key-value="<%= ENV['MAPBOX_API_KEY'] %>"
              data-map-markers-value="<%= @parcel.coordinates_4326.to_json %>"
              data-map-parcel-name-value="<%= @parcel.name %>"
              data-map-parcel-kaek-value="<%= @parcel.kaek %>"
              data-map-parcel-area-value="<%= @parcel.area %>">
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="row mb-4">
    <div class="col-md-12">
      <div class="d-flex justify-content-end gap-2">
        <%= button_to parcel_path(@parcel),
                    method: :delete,
                    data: { confirm: 'Are you sure you want to delete this parcel? This action cannot be undone.' }, 
                    class: 'btn btn-danger' do %>
          <i class="fa-solid fa-trash"></i> Delete Parcel
        <% end %>
      </div>
    </div>
  </div>

  <!-- Coordinates Section - Original Layout -->
  <div class="container_coordinates" data-controller="toggle-button">
    <button
    class="btn-coordinates mt-2 mb-4"
    data-action="click->toggle-button#toggle">
    Coordinates  <i class="fa-solid fa-location-dot"></i>
    </button>
    <!-- Coordinates Table -->
    <div class="coordinates"
    data-toggle-button-target="coordinates">
    <h4>Coordinates in EPSG:2100 and EPSG:4326</h4>
    <table class="table table-bordered">
      <thead>
        <tr>
          <th>#</th>
          <th>Coordinates 2100 (X, Y)</th>
          <th>Coordinates 4326 (Longitude, Latitude)</th>
        </tr>
      </thead>
      <tbody>
        <% @parcel.coordinates_2100.each_with_index do |coord_2100, index| %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= coord_2100.join(", ") %></td>
            <td>
              <% if @parcel.coordinates_4326[index].present? %>
                <%= @parcel.coordinates_4326[index].join(", ") %>
              <% else %>
                N/A <!-- Or you can use some other placeholder -->
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>
</div>
